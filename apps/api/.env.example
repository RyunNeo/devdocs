DATABASE_URL=postgresql+psycopg://devdocs:devdocs@127.0.0.1:5432/devdocs_ai
ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:8000","http://127.0.0.1:8000"]
COOKIE_NAME=devdocs_session
COOKIE_SECURE=false
SESSION_DAYS=7
# Relative paths resolve under apps/api, not the shell's current directory.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=10485760
# Provider key stays on the backend; never use NEXT_PUBLIC_ for secrets.
SILICONFLOW_API_KEY=
EMBEDDING_BATCH_SIZE=16
INDEXING_TIMEOUT_SECONDS=60
# 每次只保留一个未注释的 CHAT_MODEL，修改后重启后端
# CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
CHAT_MODEL=Qwen/Qwen3-32B
# CHAT_MODEL=Pro/zai-org/GLM-5.2
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=90
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY='0.35'
